# Environment variables for On-Chain Resume
# Copy this file to .env.local and fill in real values

# WalletConnect project ID (get at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Deployed contract address on Sepolia testnet
# Run `npm run deploy:sepolia` and paste the output address here
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000

# Local Hardhat node contract address (default first deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS_LOCAL=0x5FbDB2315678afecb367f032d93F642f64180aa3

# RPC endpoint for Sepolia (Alchemy or Infura)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key

# Deployer private key — NEVER commit this to git
PRIVATE_KEY=0xyour_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_key

# NFT.Storage API key for IPFS metadata uploads (https://nft.storage)
NEXT_PUBLIC_NFT_STORAGE_KEY=your_nft_storage_key
